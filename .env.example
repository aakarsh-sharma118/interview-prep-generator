# Server Network Configuration
PORT=5000
NODE_ENV=development
FRONT_END_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Persistence
# Optional: If not provided, an in-memory embedded MongoDB instance is used automatically
# to guarantee zero-setup execution on clean clone evaluation environments.
MONGODB_URI=mongodb://localhost:27017/trao_prep

# Authentication Security
JWT_SECRET=super_secret_jwt_encryption_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# LLM Provider Configuration (gemini | groq | openai | mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & Crawler Configuration
# When true, permits local loopback/private URLs (e.g. http://localhost:8099/acme/)
# as explicitly required by Section 9 & 11 for local test cases. In production, this is false.
ALLOW_LOCAL_URLS=true
CRAWLER_TIMEOUT_MS=5000
CRAWLER_MAX_PAGES=4
